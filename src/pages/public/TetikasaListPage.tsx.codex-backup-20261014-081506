import { useCallback, useEffect, useMemo, useState } from 'react'
import { CalendarDays, ChevronLeft, ChevronRight, Eye, FolderKanban, LayoutGrid, List, MapPin, RefreshCw, Search, UserRound, WalletCards } from 'lucide-react'
import { Link } from 'react-router-dom'
import { listTetikasa } from '../../api/tetikasa'
import { useLanguage } from '../../hooks/useLanguage'
import type { TetikasaListItem, TetikasaStatusCode } from '../../types/tetikasa'
import './Tetikasa.css'

const PAGE_SIZE = 10

type SortMode = 'RECENT' | 'OLDEST' | 'TITLE_ASC' | 'TITLE_DESC'
type PeriodFilter = 'ALL' | 'PLANNED' | 'UNSCHEDULED'
type ViewMode = 'TABLE' | 'GRID'

function formatAriary(value: string) {
  const normalized = value.trim()
  if (!/^\d+(?:\.\d+)?$/.test(normalized)) return value

  const [whole, decimal = ''] = normalized.split('.')
  const grouped = whole.replace(/\B(?=(\d{3})+(?!\d))/g, ' ')
  const usefulDecimal = decimal.replace(/0+$/, '')
  return `${grouped}${usefulDecimal ? `,${usefulDecimal}` : ''} Ar`
}

export function TetikasaListPage() {
  const { language, t } = useLanguage()
  const [items, setItems] = useState<TetikasaListItem[]>([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState('')
  const [query, setQuery] = useState('')
  const [status, setStatus] = useState<'ALL' | TetikasaStatusCode>('ALL')
  const [periodFilter, setPeriodFilter] = useState<PeriodFilter>('ALL')
  const [locationFilter, setLocationFilter] = useState('ALL')
  const [sort, setSort] = useState<SortMode>('RECENT')
  const [view, setView] = useState<ViewMode>('TABLE')
  const [page, setPage] = useState(1)

  const load = useCallback(() => {
    let active = true
    setLoading(true)
    setError('')
    void listTetikasa()
      .then((response) => { if (active) setItems(response.data ?? []) })
      .catch((reason: unknown) => {
        console.error(reason)
        if (active) setError(t('tetikasa.listLoadError'))
      })
      .finally(() => { if (active) setLoading(false) })
    return () => { active = false }
  }, [t])

  useEffect(() => load(), [load])
  useEffect(() => { setPage(1) }, [query, status, periodFilter, locationFilter, sort])

  const personName = (item: TetikasaListItem) => [item.created_by.nom, item.created_by.prenom].filter(Boolean).join(' ') || t('tetikasa.noPerson')
  const place = (item: TetikasaListItem) => item.lieu?.trim() || (item.lieu_non_defini ? t('tetikasa.locationUnknown') : t('tetikasa.notProvidedF'))
  const locationKey = (item: TetikasaListItem) => item.lieu?.trim() || (item.lieu_non_defini ? '__UNDEFINED__' : '__EMPTY__')
  const hasPeriod = (item: TetikasaListItem) => Boolean(item.date_debut_prevue || item.date_fin_prevue)
  const period = (item: TetikasaListItem) => `${item.date_debut_prevue || t('tetikasa.notProvidedF')} - ${item.date_fin_prevue || t('tetikasa.notProvidedF')}`
  const creationDate = (value: string) => {
    try { return new Intl.DateTimeFormat(language === 'mg' ? 'mg-MG' : 'fr-FR', { dateStyle: 'medium' }).format(new Date(value)) }
    catch { return new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium' }).format(new Date(value)) }
  }

  const locations = useMemo(() => Array.from(new Map(items.map((item) => [locationKey(item), place(item)])).entries()), [items, language, t])
  const filteredItems = useMemo(() => {
    const needle = query.trim().toLocaleLowerCase(language === 'mg' ? 'mg' : 'fr')
    const filtered = items.filter((item) => {
      const matchesQuery = !needle || [item.titre, item.lieu, item.created_by.nom, item.created_by.prenom].filter(Boolean).join(' ').toLocaleLowerCase().includes(needle)
      const matchesStatus = status === 'ALL' || item.statut.code === status
      const matchesPeriod = periodFilter === 'ALL' || (periodFilter === 'PLANNED' ? hasPeriod(item) : !hasPeriod(item))
      const matchesLocation = locationFilter === 'ALL' || locationKey(item) === locationFilter
      return matchesQuery && matchesStatus && matchesPeriod && matchesLocation
    })
    return filtered.sort((left, right) => {
      if (sort === 'OLDEST') return left.date_creation.localeCompare(right.date_creation) || left.id.localeCompare(right.id)
      if (sort === 'TITLE_ASC') return (left.titre || '').localeCompare(right.titre || '', language) || left.id.localeCompare(right.id)
      if (sort === 'TITLE_DESC') return (right.titre || '').localeCompare(left.titre || '', language) || left.id.localeCompare(right.id)
      return right.date_creation.localeCompare(left.date_creation) || right.id.localeCompare(left.id)
    })
  }, [items, language, locationFilter, periodFilter, query, sort, status])

  const pageCount = Math.max(1, Math.ceil(filteredItems.length / PAGE_SIZE))
  const currentPage = Math.min(page, pageCount)
  const pageItems = filteredItems.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE)
  const first = filteredItems.length ? (currentPage - 1) * PAGE_SIZE + 1 : 0
  const last = filteredItems.length ? first + pageItems.length - 1 : 0
  const draftsCount = items.filter((item) => item.statut.code === 'DRAFITRA').length
  const renderStatus = (item: TetikasaListItem) => <span className="tetikasa-status">{item.statut.code === 'DRAFITRA' ? t('tetikasa.statusDraft') : item.statut.code}</span>
  const projectLink = (item: TetikasaListItem) => <Link className="tetikasa-list-view" to={`/tetikasa/${item.id}`} aria-label={`${t('tetikasa.listView')} : ${item.titre || t('tetikasa.untitled')}`}><Eye size={18} aria-hidden="true" /><span>{t('tetikasa.listView')}</span></Link>

  return <main className="tetikasa-page tetikasa-list-page">
    <header className="tetikasa-list-hero">
      <div className="tetikasa-list-hero-icon"><FolderKanban size={34} aria-hidden="true" /></div>
      <div className="tetikasa-list-hero-copy"><span className="tetikasa-list-eyebrow">{t('tetikasa.projectManagement')}</span><h1>{t('tetikasa.listTitle')}</h1><p>{t('tetikasa.listSubtitle')}</p></div>
      <div className="tetikasa-list-stats" aria-label={t('tetikasa.listTitle')}><div className="tetikasa-list-stat tetikasa-list-stat-total"><strong>{items.length}</strong><span>{t('tetikasa.listTotal')}</span></div><div className="tetikasa-list-stat tetikasa-list-stat-draft"><strong>{draftsCount}</strong><span>{t('tetikasa.listDrafts')}</span></div></div>
    </header>

    {loading && <section className="tetikasa-list-state" aria-live="polite"><RefreshCw className="tetikasa-list-spinner" size={26} aria-hidden="true" /><p>{t('tetikasa.listLoading')}</p></section>}
    {!loading && error && <section className="tetikasa-list-state tetikasa-list-state-error" role="alert"><p>{error}</p><button type="button" className="tetikasa-list-retry" onClick={() => void load()}><RefreshCw size={16} aria-hidden="true" />{t('tetikasa.retry')}</button></section>}
    {!loading && !error && items.length === 0 && <section className="tetikasa-list-state"><FolderKanban size={32} aria-hidden="true" /><h2>{t('tetikasa.listEmpty')}</h2><p>{t('tetikasa.listEmptyHelp')}</p></section>}

    {!loading && !error && items.length > 0 && <>
      <section className="tetikasa-list-toolbar" aria-label={t('tetikasa.projectManagement')}>
        <label className="tetikasa-list-search"><Search size={20} aria-hidden="true" /><span className="sr-only">{t('tetikasa.searchProjects')}</span><input value={query} onChange={(event) => setQuery(event.target.value)} placeholder={t('tetikasa.searchProjects')} /></label>
        <select value={status} onChange={(event) => setStatus(event.target.value as 'ALL' | TetikasaStatusCode)} aria-label={t('tetikasa.filterStatus')}><option value="ALL">{t('tetikasa.allStatuses')}</option><option value="DRAFITRA">{t('tetikasa.statusDraft')}</option></select>
        <select value={periodFilter} onChange={(event) => setPeriodFilter(event.target.value as PeriodFilter)} aria-label={t('tetikasa.filterPeriod')}><option value="ALL">{t('tetikasa.allPeriods')}</option><option value="PLANNED">{t('tetikasa.periodPlanned')}</option><option value="UNSCHEDULED">{t('tetikasa.periodUnscheduled')}</option></select>
        <select value={locationFilter} onChange={(event) => setLocationFilter(event.target.value)} aria-label={t('tetikasa.filterLocation')}><option value="ALL">{t('tetikasa.allLocations')}</option>{locations.map(([key, label]) => <option key={key} value={key}>{label}</option>)}</select>
        <select className="tetikasa-list-sort" value={sort} onChange={(event) => setSort(event.target.value as SortMode)} aria-label={t('tetikasa.sortRecent')}><option value="RECENT">{t('tetikasa.sortRecent')}</option><option value="OLDEST">{t('tetikasa.sortOldest')}</option><option value="TITLE_ASC">{t('tetikasa.sortTitleAsc')}</option><option value="TITLE_DESC">{t('tetikasa.sortTitleDesc')}</option></select>
        <div className="tetikasa-list-view-toggle" aria-label={t('tetikasa.actions')}><button type="button" className={view === 'TABLE' ? 'active' : ''} aria-pressed={view === 'TABLE'} onClick={() => setView('TABLE')} title={t('tetikasa.tableView')}><List size={20} aria-hidden="true" /><span className="sr-only">{t('tetikasa.tableView')}</span></button><button type="button" className={view === 'GRID' ? 'active' : ''} aria-pressed={view === 'GRID'} onClick={() => setView('GRID')} title={t('tetikasa.gridView')}><LayoutGrid size={19} aria-hidden="true" /><span className="sr-only">{t('tetikasa.gridView')}</span></button></div>
      </section>

      {filteredItems.length === 0 ? <section className="tetikasa-list-state"><Search size={30} aria-hidden="true" /><h2>{t('tetikasa.listNoResults')}</h2></section> : view === 'TABLE' ? <section className="tetikasa-list-table-panel"><div className="tetikasa-list-table-wrap"><table><thead><tr><th>{t('tetikasa.rowNumber')}</th><th>{t('tetikasa.project')}</th><th>{t('tetikasa.filterStatus')}</th><th>{t('tetikasa.location')}</th><th>{t('tetikasa.plannedPeriod')}</th><th>{t('tetikasa.budget')}</th><th>{t('tetikasa.createdBy')}</th><th>{t('tetikasa.actions')}</th></tr></thead><tbody>{pageItems.map((item, index) => <tr key={item.id}><td className="tetikasa-list-index">{first + index}</td><td><strong className="tetikasa-list-project-name">{item.titre || t('tetikasa.untitled')}</strong><small>{t('tetikasa.listCreated')} {creationDate(item.date_creation)}</small></td><td>{renderStatus(item)}</td><td><span className="tetikasa-list-cell-icon"><MapPin size={17} aria-hidden="true" />{place(item)}</span></td><td><span className="tetikasa-list-cell-icon"><CalendarDays size={17} aria-hidden="true" />{period(item)}</span></td><td className="tetikasa-list-money">{formatAriary(item.total_budget_calcule)}</td><td><span className="tetikasa-list-cell-icon"><UserRound size={17} aria-hidden="true" />{personName(item)}</span></td><td>{projectLink(item)}</td></tr>)}</tbody></table></div><footer className="tetikasa-list-pagination"><p>{t('tetikasa.showing')} {first} {t('tetikasa.to')} {last} {t('tetikasa.of')} {filteredItems.length} {t('tetikasa.listCount')}</p><div><button type="button" onClick={() => setPage(currentPage - 1)} disabled={currentPage === 1} aria-label={t('tetikasa.previous')}><ChevronLeft size={19} aria-hidden="true" /></button><span aria-current="page">{currentPage}</span><button type="button" onClick={() => setPage(currentPage + 1)} disabled={currentPage === pageCount} aria-label={t('tetikasa.next')}><ChevronRight size={19} aria-hidden="true" /></button></div></footer></section> : <><section className="tetikasa-list-grid">{pageItems.map((item, index) => <article className="tetikasa-list-card" key={item.id}><header><span className="tetikasa-list-index">{first + index}</span>{renderStatus(item)}</header><h2>{item.titre || t('tetikasa.untitled')}</h2><dl className="tetikasa-list-meta"><div><dt><MapPin size={17} aria-hidden="true" />{t('tetikasa.location')}</dt><dd>{place(item)}</dd></div><div><dt><CalendarDays size={17} aria-hidden="true" />{t('tetikasa.plannedPeriod')}</dt><dd>{period(item)}</dd></div><div><dt><UserRound size={17} aria-hidden="true" />{t('tetikasa.createdBy')}</dt><dd>{personName(item)}</dd></div></dl><footer><div className="tetikasa-list-budget"><span><WalletCards size={17} aria-hidden="true" />{t('tetikasa.budget')}</span><strong>{formatAriary(item.total_budget_calcule)}</strong></div>{projectLink(item)}</footer></article>)}</section><footer className="tetikasa-list-pagination tetikasa-list-grid-pagination"><p>{t('tetikasa.showing')} {first} {t('tetikasa.to')} {last} {t('tetikasa.of')} {filteredItems.length} {t('tetikasa.listCount')}</p><div><button type="button" onClick={() => setPage(currentPage - 1)} disabled={currentPage === 1} aria-label={t('tetikasa.previous')}><ChevronLeft size={19} aria-hidden="true" /></button><span aria-current="page">{currentPage}</span><button type="button" onClick={() => setPage(currentPage + 1)} disabled={currentPage === pageCount} aria-label={t('tetikasa.next')}><ChevronRight size={19} aria-hidden="true" /></button></div></footer></>}
    </>}
  </main>
}